{
    "require": {
        "latte/latte": "^3.1",
        "nette/application": "^3.3",
        "nette/bootstrap": "^3.3",
        "nette/di": "^3.2",
        "nette/http": "^3.4",
        "nette/utils": "^4.1",
        "nette/robot-loader": "^4.1",
        "tracy/tracy": "^2.12",
        "nette/database": "^3.2"
    },
    "autoload": {
