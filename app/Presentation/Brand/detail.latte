{block content}
<section class="bg-neutral-950 py-16">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<a n:href="Brand:default" class="text-xs font-bold uppercase tracking-[0.3em] text-brand-500 transition hover:text-brand-400">&larr; Semua Brand</a>

		<div class="mt-6 border-l-4 border-brand-500 pl-6">
			<h1 class="text-4xl font-black uppercase tracking-tight text-neutral-100 sm:text-5xl">{$brand['nama']}</h1>
			<p class="mt-3 text-sm uppercase tracking-[0.2em] text-neutral-400">{$brand['negara'] ?? 'Asal belum diisi'}</p>
		</div>

		<dl class="mt-10 grid gap-px border border-neutral-800 bg-neutral-800 sm:grid-cols-3">
			<div class="bg-neutral-900 px-6 py-5">
				<dt class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-500">ID</dt>
				<dd class="mt-1 text-lg font-black text-neutral-100">#{$brand['id']}</dd>
			</div>
			<div class="bg-neutral-900 px-6 py-5">
				<dt class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-500">Negara</dt>
				<dd class="mt-1 text-lg font-black text-neutral-100">{$brand['negara'] ?? '—'}</dd>
			</div>
			<div class="bg-neutral-900 px-6 py-5">
				<dt class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-500">Terdaftar</dt>
				<dd class="mt-1 text-lg font-black text-neutral-100">{$brand['created_at']|date:'d M Y'}</dd>
			</div>
		</dl>

		<div class="mt-10">
			<a n:href="Catalog:default" class="inline-flex items-center gap-2 bg-brand-600 px-7 py-3 text-sm font-bold uppercase tracking-widest text-white transition hover:bg-brand-500">
				Lihat Katalog Motor
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
			</a>
		</div>
	</div>
</section>
{/block}
