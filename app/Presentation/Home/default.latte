{block content}
<!-- ================= HERO ================= -->
<section class="relative overflow-hidden bg-neutral-950 text-neutral-100">
	<!-- panel terang kanan (area foto) -->
	<div class="absolute inset-y-0 right-[-14%] hidden w-[52%] -skew-x-12 bg-neutral-200 md:block"></div>
	<!-- strip abu tipis -->
	<div class="absolute inset-y-0 right-[44%] hidden w-2 -skew-x-12 bg-neutral-700/70 md:block"></div>
	<!-- pita merah diagonal -->
	<div class="absolute inset-y-0 right-[40%] hidden w-8 -skew-x-12 bg-gradient-to-b from-brand-500 via-brand-600 to-brand-800 md:block lg:w-12"></div>
	<!-- aksen merah mobile -->
	<div class="absolute -right-14 top-0 h-full w-20 -skew-x-12 bg-gradient-to-b from-brand-500 to-brand-700 md:hidden"></div>

	<div class="relative mx-auto max-w-6xl px-4 sm:px-6">
		<div class="grid gap-12 pb-14 pt-14 md:grid-cols-2 md:items-end md:gap-4 md:pb-24 md:pt-24">
			<!-- judul besar -->
			<div>
				<p class="inline-flex items-center gap-2 border border-brand-500/50 bg-brand-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.3em] text-brand-400">
					motoDB &bull; Database Motor
				</p>
				<h1 class="mt-6">
					<span class="block text-6xl font-black uppercase leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">{$featured['model']}</span>
					<span class="mt-4 flex items-center gap-4">
						<span class="h-1 w-14 bg-brand-500"></span>
						<span class="text-2xl font-black uppercase tracking-[0.25em] text-brand-500 sm:text-3xl">{$featured['merek']}</span>
					</span>
				</h1>
				<p class="mt-6 max-w-md text-neutral-400">
					Telusuri spesifikasi dan harga motor pilihanmu &mdash; semuanya dalam satu database.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a n:href="Catalog:detail $featured['id']" class="inline-flex items-center gap-2 bg-brand-600 px-7 py-3 text-sm font-bold uppercase tracking-widest text-white shadow-lg shadow-brand-600/30 transition hover:bg-brand-500">
						Lihat Detail
						<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
					<a n:href="Catalog:default" class="inline-flex items-center border border-neutral-700 px-7 py-3 text-sm font-bold uppercase tracking-widest text-neutral-200 transition hover:border-brand-500 hover:text-brand-400">
						Semua Motor
					</a>
				</div>
			</div>

			<!-- motor + info -->
			<div class="relative">
				{include bike, body: '#e5342b', bodyDark: '#9f1a1a', uid: 'hero'}
				<div class="mt-4 text-neutral-100 md:mt-6 md:text-neutral-900">
					<p class="text-2xl font-black uppercase tracking-tight sm:text-3xl">
						<span class="text-brand-500">{$featured['tipe']}</span>
					</p>
					<p class="mt-1 text-sm font-medium text-neutral-400 md:text-neutral-600">
						Rp {number_format($featured['harga'], 0, ',', '.')} &bull; Harga OTR &bull; Stok tersedia
					</p>
				</div>
			</div>
		</div>
	</div>

	<!-- strip statistik -->
	{do $brandCount = count(array_unique(array_column($motors, 'merek')))}
	<div class="relative border-t border-neutral-800/80">
		<div class="mx-auto grid max-w-6xl grid-cols-3 divide-x divide-neutral-800 px-4 sm:px-6">
			<div class="px-2 py-5 text-center">
				<p class="text-xl font-black text-brand-500 sm:text-2xl">{count($motors)}</p>
				<p class="mt-0.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-500">Motor Terdaftar</p>
			</div>
			<div class="px-2 py-5 text-center">
				<p class="text-xl font-black text-brand-500 sm:text-2xl">{$brandCount}</p>
				<p class="mt-0.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-500">Merek</p>
			</div>
			<div class="px-2 py-5 text-center">
				<p class="text-xl font-black text-brand-500 sm:text-2xl">100%</p>
				<p class="mt-0.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-500">Gratis</p>
			</div>
		</div>
	</div>
</section>

<!-- ================= MOTOR UNGGULAN ================= -->
<section class="bg-neutral-950 py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="text-center">
			<h2 class="text-3xl font-black uppercase tracking-wide text-neutral-100 sm:text-4xl">
				Motor <span class="text-brand-500">Unggulan</span>
			</h2>
			<p class="mt-2 text-sm text-neutral-400">Pilihan motor terbaik, siap mengaspal bersahaja.</p>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{foreach $motors as $motor}
			<a n:href="Catalog:detail $motor['id']" class="group relative flex flex-col bg-neutral-100 text-neutral-900 shadow-lg shadow-black/40 transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-brand-500/25">
				<span class="absolute left-3 top-3 z-10 bg-neutral-950/85 px-2 py-1 font-mono text-[11px] font-bold text-brand-400">0{$iterator->counter}</span>
				<div class="flex items-center justify-center px-6 pt-10">
					<div class="w-full max-w-[230px]">
						{if $iterator->counter === 1}
							{include bike, body: '#2563eb', bodyDark: '#1e40af', uid: 'card1'}
						{elseif $iterator->counter === 2}
							{include bike, body: '#1f2937', bodyDark: '#030712', uid: 'card2'}
						{else}
							{include bike, body: '#e5342b', bodyDark: '#9f1a1a', uid: 'card3'}
						{/if}
					</div>
				</div>
				<div class="flex flex-1 items-end justify-between gap-3 px-6 pb-5">
					<div>
						<h3 class="text-lg font-black uppercase leading-tight">{$motor['nama']}</h3>
						<p class="mt-0.5 text-xs font-medium uppercase tracking-wider text-neutral-500">{$motor['tipe']}</p>
						<p class="mt-2 text-xl font-black text-brand-600">Rp {number_format($motor['harga'], 0, ',', '.')}</p>
					</div>
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white shadow-md shadow-brand-600/40 transition group-hover:scale-110 group-hover:bg-brand-500">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
					</span>
				</div>
			</a>
			{/foreach}
		</div>
	</div>
</section>

<!-- ================= AKSESORIS ================= -->
<section class="bg-neutral-950 pb-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="text-center">
			<h2 class="text-3xl font-black uppercase tracking-wide text-neutral-100 sm:text-4xl">
				Aksesoris <span class="text-brand-500">Pilihan</span>
			</h2>
			<p class="mt-2 text-sm text-neutral-400">Lengkapi motormu dengan perlengkapan berkualitas.</p>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{foreach $accessories as $item}
			<div class="group flex flex-col bg-neutral-100 text-neutral-900 shadow-lg shadow-black/40 transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-brand-500/25">
				<div class="relative flex h-44 items-center justify-center p-6">
					<span class="absolute left-3 top-3 bg-neutral-950/85 px-2 py-1 font-mono text-[11px] font-bold text-brand-400">0{$iterator->counter}</span>
					<div class="h-full w-full max-w-[130px]">
						{include accessoryIcon, type: $item['ikon'], uid: 'acc' . $iterator->counter}
					</div>
				</div>
				<div class="flex flex-1 flex-col px-5 pb-5">
					<h3 class="text-base font-black uppercase leading-tight">{$item['nama']}</h3>
					<p class="mt-1 text-xs font-medium uppercase tracking-wider text-neutral-500">{$item['kategori']}</p>
					<p class="mt-3 text-lg font-black text-brand-600">Rp {number_format($item['harga'], 0, ',', '.')}</p>
					<span class="mt-4 inline-flex items-center justify-center gap-2 bg-brand-600 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition group-hover:bg-brand-500">
						Pesan Sekarang
					</span>
				</div>
			</div>
			{/foreach}
		</div>
	</div>
</section>

<!-- ================= BANNER ================= -->
<section class="bg-neutral-100 py-16 md:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="grid overflow-hidden bg-neutral-950 shadow-2xl shadow-neutral-900/30 md:grid-cols-[1.15fr_0.85fr]">
			<div class="relative z-10 bg-brand-600 px-8 py-12 text-white sm:px-12 md:py-16 md:[clip-path:polygon(0_0,100%_0,86%_100%,0_100%)]">
				<h2 class="text-3xl font-black uppercase leading-tight sm:text-4xl">
					Aman, Nyaman<br>&amp; Menyenangkan
				</h2>
				<p class="mt-4 max-w-md text-sm leading-relaxed text-white/90">
					motoDB membantu kamu menemukan motor yang tepat &mdash; lengkap dengan tipe,
					spesifikasi, dan harga terbaru dalam satu database terpadu.
				</p>
				<a n:href="Catalog:default" class="mt-8 inline-flex items-center gap-2 bg-neutral-950 px-7 py-3 text-sm font-bold uppercase tracking-widest text-white transition hover:bg-neutral-800">
					Mulai Telusuri
					<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			</div>
			<div class="relative hidden items-center md:flex md:-ml-20">
				<div class="pointer-events-none absolute inset-0 opacity-50">
					<div class="absolute inset-y-0 left-10 w-12 -skew-x-12 bg-neutral-800"></div>
					<div class="absolute inset-y-0 left-28 w-2 -skew-x-12 bg-brand-600"></div>
					<div class="absolute inset-y-0 right-8 w-16 -skew-x-12 bg-neutral-800/70"></div>
				</div>
				<div class="relative w-full max-w-sm px-10">
					{include bike, body: '#e5342b', bodyDark: '#9f1a1a', uid: 'banner'}
				</div>
			</div>
		</div>
	</div>
</section>
{/block}

{define wheel, $cx = 150}
<g>
	<circle cx="{$cx}" cy="290" r="62" fill="#0b0b0e" stroke="#2c2c33" stroke-width="7"/>
	<circle cx="{$cx}" cy="290" r="36" fill="#15151a" stroke="#3f3f47" stroke-width="3"/>
	<g stroke="#56565f" stroke-width="3" stroke-linecap="round">
		<line x1="{$cx}" y1="258" x2="{$cx}" y2="322"/>
		<line x1="{$cx - 32}" y1="290" x2="{$cx + 32}" y2="290"/>
		<line x1="{$cx - 23}" y1="267" x2="{$cx + 23}" y2="313"/>
		<line x1="{$cx + 23}" y1="267" x2="{$cx - 23}" y2="313"/>
	</g>
	<circle cx="{$cx}" cy="290" r="8" fill="#a6a6af"/>
</g>
{/define}

{define accessoryIcon, $type = 'ban', $uid = 'a'}
{if $type === 'ban'}
<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="h-full w-full" aria-hidden="true">
	<circle cx="50" cy="50" r="46" fill="#18181b"/>
	<circle cx="50" cy="50" r="46" fill="none" stroke="#3f3f47" stroke-width="2"/>
	<circle cx="50" cy="50" r="33" fill="#0d0d10"/>
	<g stroke="#4b4b55" stroke-width="5" stroke-linecap="round">
		<line x1="50" y1="6" x2="50" y2="17"/>
		<line x1="50" y1="83" x2="50" y2="94"/>
		<line x1="6" y1="50" x2="17" y2="50"/>
		<line x1="83" y1="50" x2="94" y2="50"/>
		<line x1="19" y1="19" x2="27" y2="27"/>
		<line x1="73" y1="73" x2="81" y2="81"/>
		<line x1="81" y1="19" x2="73" y2="27"/>
		<line x1="27" y1="73" x2="19" y2="81"/>
	</g>
	<circle cx="50" cy="50" r="22" fill="#1c1c22" stroke="#3f3f47" stroke-width="2"/>
	<circle cx="50" cy="50" r="7" fill="#a6a6af"/>
</svg>
{elseif $type === 'velg'}
<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="h-full w-full" aria-hidden="true">
	<circle cx="50" cy="50" r="45" fill="none" stroke="#b7b7c0" stroke-width="8"/>
	<circle cx="50" cy="50" r="39" fill="none" stroke="#8a8a94" stroke-width="2"/>
	<g stroke="#c4c4cc" stroke-width="5" stroke-linecap="round">
		<line x1="50" y1="50" x2="50" y2="13"/>
		<line x1="50" y1="50" x2="85" y2="39"/>
		<line x1="50" y1="50" x2="72" y2="81"/>
		<line x1="50" y1="50" x2="28" y2="81"/>
		<line x1="50" y1="50" x2="15" y2="39"/>
	</g>
	<circle cx="50" cy="50" r="12" fill="#a6a6af"/>
	<circle cx="50" cy="50" r="6" fill="#52525b"/>
</svg>
{elseif $type === 'knalpot'}
<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="h-full w-full" aria-hidden="true">
	<g transform="rotate(-16 50 52)">
		<rect x="6" y="44" width="58" height="20" rx="10" fill="#9a9aa4"/>
		<rect x="6" y="44" width="58" height="8" rx="4" fill="#c4c4cc"/>
		<rect x="58" y="38" width="30" height="32" rx="14" fill="#b7b7c0"/>
		<rect x="58" y="38" width="30" height="12" rx="6" fill="#d4d4da"/>
		<circle cx="88" cy="54" r="13" fill="#1a1a20"/>
		<circle cx="88" cy="54" r="8" fill="#0d0d10"/>
		<rect x="20" y="36" width="8" height="14" rx="3" fill="#71717a"/>
	</g>
</svg>
{else}
<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="h-full w-full" aria-hidden="true">
	<circle cx="50" cy="50" r="44" fill="#b7b7c0"/>
	<circle cx="50" cy="50" r="44" fill="none" stroke="#8a8a94" stroke-width="2"/>
	<circle cx="50" cy="50" r="33" fill="none" stroke="#8a8a94" stroke-width="2"/>
	<g fill="#6b6b74">
		<circle cx="50" cy="17" r="4"/>
		<circle cx="73" cy="27" r="4"/>
		<circle cx="83" cy="50" r="4"/>
		<circle cx="73" cy="73" r="4"/>
		<circle cx="50" cy="83" r="4"/>
		<circle cx="27" cy="73" r="4"/>
		<circle cx="17" cy="50" r="4"/>
		<circle cx="27" cy="27" r="4"/>
	</g>
	<circle cx="50" cy="50" r="16" fill="#3f3f47"/>
	<circle cx="50" cy="50" r="7" fill="#a6a6af"/>
	<rect x="76" y="34" width="14" height="32" rx="6" fill="#e5342b"/>
</svg>
{/if}
{/define}

{define bike, $body = '#e5342b', $bodyDark = '#9f1a1a', $uid = 'a'}
<svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" class="h-auto w-full" aria-hidden="true">
	<defs>
		<linearGradient id="tank-{$uid}" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0%" stop-color="{$body}"/>
			<stop offset="100%" stop-color="{$bodyDark}"/>
		</linearGradient>
	</defs>

	<ellipse cx="320" cy="358" rx="265" ry="11" fill="rgba(0,0,0,0.35)"/>

	{include wheel, cx: 150}
	{include wheel, cx: 490}

	<!-- swingarm + shock -->
	<path d="M150 290 L272 248" stroke="#31313a" stroke-width="14" stroke-linecap="round"/>
	<path d="M288 242 L322 194" stroke="#43434c" stroke-width="9" stroke-linecap="round"/>

	<!-- exhaust -->
	<path d="M348 266 C400 266 432 244 470 220" fill="none" stroke="#87878f" stroke-width="12" stroke-linecap="round"/>
	<g transform="rotate(-12 492 213)">
		<rect x="440" y="202" width="104" height="22" rx="11" fill="#b7b7c0"/>
		<rect x="526" y="202" width="18" height="22" rx="8" fill="#dcdce2"/>
	</g>

	<!-- engine -->
	<rect x="262" y="214" width="104" height="76" rx="10" fill="#191920" stroke="#3a3a44" stroke-width="3"/>
	<g stroke="#3a3a44" stroke-width="3">
		<line x1="272" y1="232" x2="356" y2="232"/>
		<line x1="272" y1="246" x2="356" y2="246"/>
		<line x1="272" y1="260" x2="356" y2="260"/>
		<line x1="272" y1="274" x2="356" y2="274"/>
	</g>
	<rect x="298" y="192" width="48" height="26" rx="5" fill="#24242c" stroke="#3a3a44" stroke-width="3"/>

	<!-- frame -->
	<path d="M438 148 L450 170 Q452 178 442 182 L364 198 Q332 204 318 216" fill="none" stroke="#2a2a32" stroke-width="13" stroke-linecap="round"/>

	<!-- seat + tail -->
	<path d="M312 168 C280 162 240 160 212 166 L206 184 C248 188 292 188 314 184 Z" fill="#141419"/>
	<path d="M170 146 L216 162 L208 186 L172 178 Z" fill="{$bodyDark}"/>

	<!-- tangki -->
	<path d="M310 170 C312 148 340 136 372 138 C410 140 436 148 442 160 C446 168 442 176 432 180 C400 190 350 192 322 186 C314 184 310 178 310 170 Z" fill="url(#tank-{$uid})"/>
	<path d="M324 156 C340 146 372 142 398 146" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="6" stroke-linecap="round"/>

	<!-- garpu depan -->
	<path d="M440 146 L492 288" stroke="#4b4b55" stroke-width="11" stroke-linecap="round"/>
	<path d="M453 148 L505 290" stroke="#33333c" stroke-width="7" stroke-linecap="round"/>
	<path d="M436 250 A68 68 0 0 1 546 248" fill="none" stroke="{$body}" stroke-width="13" stroke-linecap="round"/>

	<!-- lampu + stang -->
	<circle cx="497" cy="150" r="11" fill="#e7e7ec" stroke="#2a2a32" stroke-width="3"/>
	<path d="M438 144 C428 130 420 122 410 116" fill="none" stroke="#17171c" stroke-width="9" stroke-linecap="round"/>
	<circle cx="406" cy="114" r="6" fill="#26262e"/>
	<path d="M412 116 L398 100" stroke="#26262e" stroke-width="4" stroke-linecap="round"/>
	<ellipse cx="394" cy="96" rx="9" ry="5" fill="#26262e"/>
</svg>
{/define}
